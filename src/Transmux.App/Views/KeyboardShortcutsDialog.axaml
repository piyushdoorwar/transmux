<Window
    x:Class="Transmux.App.Views.KeyboardShortcutsDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Keyboard Shortcuts"
    Width="550"
    Height="450"
    MinWidth="500"
    MinHeight="400"
    CanResize="True">

  <Grid RowDefinitions="*,Auto">

    <!-- Shortcuts list -->
    <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12" Margin="16,12,16,12">

        <!-- File operations -->
        <StackPanel Spacing="6">
          <TextBlock Text="File Operations"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentTextBrush}" />
          <Grid ColumnDefinitions="120,*">
            <TextBlock Grid.Column="0" Text="Ctrl+O" Classes="mono" FontSize="11" Foreground="{DynamicResource GreyBrush}" />
            <TextBlock Grid.Column="1" Text="Open/select input file" FontSize="11" Foreground="{DynamicResource BodyBrush}" />
          </Grid>
        </StackPanel>

        <Border Background="{DynamicResource LineBrush}" Height="1" />

        <!-- Conversion -->
        <StackPanel Spacing="6">
          <TextBlock Text="Conversion"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentTextBrush}" />
          <Grid ColumnDefinitions="120,*">
            <TextBlock Grid.Column="0" Text="Enter" Classes="mono" FontSize="11" Foreground="{DynamicResource GreyBrush}" />
            <TextBlock Grid.Column="1" Text="Convert the current file" FontSize="11" Foreground="{DynamicResource BodyBrush}" />
          </Grid>
          <Grid ColumnDefinitions="120,*">
            <TextBlock Grid.Column="0" Text="Spacebar" Classes="mono" FontSize="11" Foreground="{DynamicResource GreyBrush}" />
            <TextBlock Grid.Column="1" Text="Toggle Fast/Full re-encode mode" FontSize="11" Foreground="{DynamicResource BodyBrush}" />
          </Grid>
        </StackPanel>

        <Border Background="{DynamicResource LineBrush}" Height="1" />

        <!-- Dialogs -->
        <StackPanel Spacing="6">
          <TextBlock Text="Dialogs"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentTextBrush}" />
          <Grid ColumnDefinitions="120,*">
            <TextBlock Grid.Column="0" Text="Escape" Classes="mono" FontSize="11" Foreground="{DynamicResource GreyBrush}" />
            <TextBlock Grid.Column="1" Text="Close any open dialog or window" FontSize="11" Foreground="{DynamicResource BodyBrush}" />
          </Grid>
        </StackPanel>

        <Border Background="{DynamicResource LineBrush}" Height="1" />

        <!-- Drag &amp; Drop -->
        <StackPanel Spacing="6">
          <TextBlock Text="Drag &amp; Drop"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentTextBrush}" />
          <StackPanel Spacing="4">
            <TextBlock Text="Drag a file onto the window to load it" FontSize="11" Foreground="{DynamicResource BodyBrush}" />
          </StackPanel>
        </StackPanel>

        <Border Background="{DynamicResource LineBrush}" Height="1" />

        <!-- Tips -->
        <StackPanel Spacing="6">
          <TextBlock Text="Tips"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentTextBrush}" />
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Classes="bullet" />
              <TextBlock Text="Hover over buttons for tooltips" FontSize="11" Foreground="{DynamicResource BodyBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Classes="bullet" />
              <TextBlock Text="Right-click files in file explorer with Transmux" FontSize="11" Foreground="{DynamicResource BodyBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Classes="bullet" />
              <TextBlock Text="Command-line: transmux file1.mp4 file2.mkv" FontSize="11" Foreground="{DynamicResource BodyBrush}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="1" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Right"
                  Margin="0,0,20,0">
        <Button Name="OkButton"
                Click="CloseButton_Click"
                Classes="accent"
                CornerRadius="4"
                Padding="20,8"
                FontSize="13"
                FontWeight="SemiBold"
                Content="Got it" />
      </StackPanel>
    </Border>

  </Grid>

</Window>
